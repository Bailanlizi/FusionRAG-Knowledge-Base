# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=sk-your-api-key-here

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=fusion_rag_chunks

# PostgreSQL
POSTGRES_URL=postgresql://fusion:fusion@localhost:5432/fusion_rag

# 开发模式：无 API Key 时使用 Mock 客户端
USE_MOCK=false

# 日志级别
LOG_LEVEL=INFO
